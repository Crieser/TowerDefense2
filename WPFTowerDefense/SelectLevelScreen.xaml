<Page x:Class="WPFTowerDefense.SelectLevelScreen"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:WPFTowerDefense"
      mc:Ignorable="d" 
      d:DesignHeight="720" d:DesignWidth="1280"
      Title="SelectLevelScreen">

    <Grid Background="White">
        <Button Content="Return" Click="Return_Click" Height="50" Width="100" VerticalAlignment="Top" HorizontalAlignment="Left" Margin="10"/>
        <DockPanel Width="1225">

            <Button Content="Previous" x:Name="PreviousButton" VerticalAlignment="Top" HorizontalAlignment="Left" Click="ChangeLevel_Click" Height="50" Width="100" Margin="0,250,0,0"/>
            <StackPanel HorizontalAlignment="Left" VerticalAlignment="Top" Width="1024" Height="640">
                <Image x:Name="LevelPreview" Source="Images\levela.png" Height="512" Width="1024"/>
                <TextBlock x:Name="LevelDescription" Height="150" FontSize="25" HorizontalAlignment="Center">Placeholder description :(</TextBlock>

            </StackPanel>
            <Button Content="Next" x:Name="NextButton" VerticalAlignment="Top" Click="ChangeLevel_Click" Height="50" Width="100" HorizontalAlignment="Left" Margin="0,250,0,0" />
        </DockPanel>
        
        
        <Button Content="Play" Click="Play_Click" Height="50" Width="150" VerticalAlignment="Bottom" Margin="10"/>
        
        
    </Grid>
</Page>
