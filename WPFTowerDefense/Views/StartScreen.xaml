<UserControl x:Class="WPFTowerDefense.Views.StartScreen"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:WPFTowerDefense.Views"
             mc:Ignorable="d" 
             d:DesignHeight="775" d:DesignWidth="1295">
    <Grid>
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Top">
            <Image Source="/Images/epictitleimage.png" Height="600"/>
            <Button Content="Play" Command="{Binding PlayCommand}" FontSize="30" Width="250"/>
            <Button Content="Options" Command="{Binding OptionsCommand}" FontSize="30" Width="250"/>
            <Button Content="Exit" Command="{Binding ExitCommand}" FontSize="30" Width="250"/>
        </StackPanel>
        <DockPanel Margin="10">
            <Button Content="Guide"
                    Command="{Binding GameGuideCommand}"
                    FontSize="30"
                    Height="50"
                    Width="150"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Top"/>
        </DockPanel>
    </Grid>
</UserControl>
